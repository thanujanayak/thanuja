#include <iostream>
#include <vector>
#include <string>
using namespace std;

struct Task {
    string description;
    bool done;
};

vector<Task> tasks;

void showMenu() {
    cout << "\n--- To-Do App ---\n";
    cout << "1. Add Task\n";
    cout << "2. View Tasks\n";
    cout << "3. Complete Task\n";
    cout << "4. Delete Task\n";
    cout << "5. Exit\n";
    cout << "Choose an option: ";
}

void addTask() {
    string task;
    cout << "Enter a new task: ";
    getline(cin, task);
    tasks.push_back({task, false});
    cout << "Task added!\n";
}

void viewTasks() {
    if (tasks.empty()) {
        cout << "No tasks yet!\n";
    } else {
        for (size_t i = 0; i < tasks.size(); i++) {
            cout << i+1 << ". " << tasks[i].description 
                 << (tasks[i].done ? " [✔️]" : " [❌]") << "\n";
        }
    }
}

void completeTask() {
    viewTasks();
    int num;
    cout << "Enter task number to mark complete: ";
    cin >> num;
    cin.ignore();
    if (num > 0 && num <= tasks.size()) {
        tasks[num-1].done = true;
        cout << "Task marked complete!\n";
    }
}

void deleteTask() {
    viewTasks();
    int num;
    cout << "Enter task number to delete: ";
    cin >> num;
    cin.ignore();
    if (num > 0 && num <= tasks.size()) {
        tasks.erase(tasks.begin() + (num-1));
        cout << "Task deleted!\n";
    }
}

int main() {
    while (true) {
        showMenu();
        int choice;
        cin >> choice;
        cin.ignore();
        switch (choice) {
            case 1: addTask(); break;
            case 2: viewTasks(); break;
            case 3: completeTask(); break;
            case 4: deleteTask(); break;
            case 5: cout << "Goodbye!\n"; return 0;
            default: cout << "Invalid choice, try again.\n"""aht
        }
    }
}
